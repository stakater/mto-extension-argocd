{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mto-extension-argocd values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operatorNamespace",
    "argocd",
    "scaffolding",
    "annotations",
    "integrationConfig",
    "tenantNamespaceLabel",
    "sync",
    "onDeletePurgeAppProject",
    "rbac"
  ],
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm injects this when the chart is used as a subchart. Declared so additionalProperties:false does not reject it."
    },
    "operatorNamespace": {
      "type": "string",
      "minLength": 1,
      "description": "Namespace the Templates and the parent TemplateInstance are installed into."
    },
    "argocd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "sourceRepos"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "description": "REQUIRED. Namespace ArgoCD runs in. A blank value does not render zero children -- it renders one per tenant, each emitting an AppProject with an empty namespace that the API server rejects, so every tenant breaks at once. This minLength is the guard."
        },
        "clusterResourceWhitelist": {
          "$ref": "#/definitions/groupKindList"
        },
        "namespaceResourceBlacklist": {
          "$ref": "#/definitions/groupKindList"
        },
        "sourceRepos": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Per-tenant repo patterns, one sourceRepos entry each; {{ tenant }} is expanded to the tenant name. Empty means no sourceRepos unless a Tenant sets the annotation."
            }
          },
          "required": [
            "pattern"
          ]
        },
        "allowControlPlaneDestination": {
          "type": "boolean",
          "description": "Make the ArgoCD namespace a destination of every tenant (the legacy shape, UNSAFE: a path to ArgoCD admin, #6). Default false."
        },
        "sourceNamespaces": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Add sourceNamespaces: [<pattern>] to every AppProject (#9). Default false."
            },
            "pattern": {
              "type": "string",
              "minLength": 1,
              "description": "The tenant's Application namespace; {{ tenant }} is expanded. Default {{ tenant }}-argocd."
            }
          }
        }
      }
    },
    "scaffolding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "annotations",
        "labels"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "Always",
            "OnLabel",
            "OnAnnotation",
            "Never"
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled"
          ]
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "enabled"
          ]
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceRepos",
        "clusterResourceWhitelist",
        "namespaceResourceBlacklist",
        "onDeletePurge"
      ],
      "properties": {
        "sourceRepos": {
          "type": "string",
          "minLength": 1
        },
        "clusterResourceWhitelist": {
          "type": "string",
          "minLength": 1
        },
        "namespaceResourceBlacklist": {
          "type": "string",
          "minLength": 1
        },
        "onDeletePurge": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "integrationConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "namespace"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tenantNamespaceLabel": {
      "type": "string",
      "minLength": 1
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "off",
            "revert",
            "strict"
          ]
        },
        "ignoreFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "onDeletePurgeAppProject": {
      "type": "boolean",
      "description": "Default for whether deleting or descaffolding a Tenant deletes its AppProject; false retains, on template-operator-v2 v0.0.7 and later. Overridable per Tenant with the on-delete-purge annotation. Required and boolean so an explicit null is refused at install time -- helm strips explicitly-null keys before validation, so the required marker catches it here and _helpers.tpl repeats the check for schema-skipping render paths."
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "serviceAccount"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "serviceAccount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "namespace"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "leastPrivilege",
            "extensionsCompatible"
          ],
          "description": "leastPrivilege (default, #7) or the legacy extensionsCompatible shape for migration."
        },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Grant owner exec create (web terminal as the argocd-server ServiceAccount). Default false."
            }
          }
        },
        "clusters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "description": "Grant owner clusters * (register project-scoped clusters). Default false."
            }
          }
        }
      }
    }
  },
  "definitions": {
    "groupKindList": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "kind"
        ],
        "properties": {
          "group": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
