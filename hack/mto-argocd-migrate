#!/usr/bin/env bash
#
# mto-argocd-migrate -- move tenants from ExtensionsArgoCDReconciler to this
# chart, one tenant at a time, without deleting or disrupting an AppProject.
#
# The runbook is MIGRATION.md. This script is the executable half of it: every
# command below is one numbered step there, and every command that writes to the
# cluster is a dry run until you pass --apply.
#
# Three design notes, because they are not obvious from the code:
#
#   * The chart's live configuration is read off `Template/mto-argocd-parent`
#     rather than taken as flags. The annotation keys, the scaffolding mode and
#     the ArgoCD namespace are all chart values, and a migration driven by a
#     second, hand-typed copy of them is a migration that silently writes
#     annotations nothing reads.
#
#   * `cutover` deletes a tenant's Extensions CR BEFORE opting that tenant in.
#     That ordering is the whole point. The Extensions finalizer is released only
#     by ExtensionsArgoCDReconciler, so the CR has to go while that controller
#     still runs; and once it is gone the controller has nothing to reconcile for
#     that tenant, so the two writers never contend. The dual-run collision
#     measured in docs/upstream-issues.md simply never happens.
#
#   * Nothing here turns the old controller off, and nothing needs to. Scaling it
#     down is reverted by OLM or Helm on the next resync, and per the ordering
#     above it buys nothing. Removing it belongs to the tenant-operator upgrade,
#     once zero Extensions CRs remain.
#
# Requires: kubectl, jq. Works on bash 3.2 (macOS) and later.

set -euo pipefail

readonly EXTENSIONS_GVR='extensions.tenantoperator.stakater.com'
readonly EXTENSIONS_CRD='extensions.tenantoperator.stakater.com'
readonly TENANTS_GVR='tenants.tenantoperator.stakater.com'
readonly INTEGRATIONCONFIGS_GVR='integrationconfigs.tenantoperator.stakater.com'
readonly APPPROJECTS_GVR='appprojects.argoproj.io'
readonly TEMPLATEINSTANCES_GVR='templateinstances.templates.v2.stakater.com'
readonly TEMPLATES_GVR='templates.templates.v2.stakater.com'

readonly PARENT_NAME='mto-argocd-parent'
readonly CHILD_PREFIX='mto-argocd-tenant-'

# The ownerRef ExtensionsArgoCDReconciler stripped on every reconcile, and that
# nothing strips once that controller is gone. See MIGRATION.md, step 4.
readonly LEGACY_OWNER_APIVERSION='tenantoperator.stakater.com/v1beta2'
readonly LEGACY_OWNER_KIND='Tenant'

CONTEXT=''
OPERATOR_NS='multi-tenant-operator'
IC_NAME='tenant-operator-config'
IC_NS=''
APPLY=0

usage() {
  cat <<'EOF'
mto-argocd-migrate -- migrate tenants from the Extensions controller to
                      mto-extension-argocd. A dry run unless --apply is given.

USAGE
  hack/mto-argocd-migrate [global flags] <command> [args]

COMMANDS
  run                    The whole migration, one step at a time. START HERE.
  inventory              What exists today, and what each tenant needs. Read-only.
  values                 Chart values seeded from the live IntegrationConfig.
  annotations            Per-tenant overrides, carried across from the Extensions CRs.
  strip-owner-refs       Remove legacy v1beta2 Tenant ownerRefs from AppProjects.
  snapshot <dir>         Save every AppProject, normalised, for later comparison.
  cutover <tenant>...    Migrate tenants: retain, delete the CR, opt in, wait.
  diff <dir>             Compare live AppProjects against a snapshot.

GLOBAL FLAGS
  --context <name>          kubectl context to use.
  --operator-namespace <ns> Where the chart's Templates live. Default: multi-tenant-operator.
  --integrationconfig <n>   IntegrationConfig name. Default: tenant-operator-config.
  --ic-namespace <ns>       IntegrationConfig namespace. Default: --operator-namespace.
  --apply                   Actually write to the cluster. A dry run without it.
  --state-dir <dir>         Where `run` keeps the snapshot. Default: .mto-argocd-migrate
  --batch <n>               How many tenants `run` offers at once. Default: 1
  -h, --help                This message.

The runbook these commands belong to is MIGRATION.md.
EOF
}

# -- plumbing ----------------------------------------------------------------

die() { printf '\nerror: %s\n' "$*" >&2; exit 1; }
warn() { printf '\nwarning: %s\n' "$*" >&2; }

if [[ -t 1 ]]; then
  heading() { printf '\n\033[1m%s\033[0m\n' "$*"; }
else
  heading() { printf '\n%s\n' "$*"; }
fi

kc() {
  if [[ -n $CONTEXT ]]; then
    kubectl --context="$CONTEXT" "$@"
  else
    kubectl "$@"
  fi
}

# run echoes a mutating command and executes it only under --apply. Every write
# in this script goes through it, so a dry run is dry by construction rather
# than by remembering to guard each call site.
#
# What it echoes is the real kubectl invocation, not the `kc` wrapper, so a dry
# run doubles as a list of commands you can read, audit and paste.
run() {
  local shown=("$@")
  if [[ ${shown[0]} == kc ]]; then
    if [[ -n $CONTEXT ]]; then
      shown=(kubectl "--context=$CONTEXT" "${shown[@]:1}")
    else
      shown=(kubectl "${shown[@]:1}")
    fi
  fi
  if (( APPLY )); then
    printf '  + %s\n' "${shown[*]}"
    "$@"
  else
    printf '  would run: %s\n' "${shown[*]}"
  fi
}

require_tools() {
  local tool
  for tool in kubectl jq; do
    command -v "$tool" >/dev/null 2>&1 || die "$tool is required but is not on PATH"
  done
}

# extensions_json guards every read of the Extensions CRD. After the
# tenant-operator removal lands, that CRD is gone -- and `kubectl get` on a
# missing kind is an error, which under `set -e` would abort the script and read
# as a broken cluster rather than as a finished migration.
extensions_json() {
  if kc get crd "$EXTENSIONS_CRD" >/dev/null 2>&1; then
    kc get "$EXTENSIONS_GVR" -o json
  else
    echo '{"items":[]}'
  fi
}

appprojects_json() {
  kc get "$APPPROJECTS_GVR" -n "$1" -o json 2>/dev/null || echo '{"items":[]}'
}

integrationconfig_json() {
  kc get "$INTEGRATIONCONFIGS_GVR" "$IC_NAME" -n "$IC_NS" -o json 2>/dev/null \
    || die "IntegrationConfig $IC_NS/$IC_NAME not found.
       Point --integrationconfig / --ic-namespace at the right one."
}

# -- chart configuration, read from the cluster ------------------------------

PARENT_PARAMS=''

# try_load_chart_config returns 1 when the chart is not installed rather than
# dying, because `run` has to be able to report "not installed yet" as a state.
try_load_chart_config() {
  local parent
  parent=$(kc get "$TEMPLATES_GVR" "$PARENT_NAME" -n "$OPERATOR_NS" -o json 2>/dev/null) || return 1
  PARENT_PARAMS=$(jq -c '[.spec.parameters[] | select(has("value"))] | from_entries' <<<"$parent")
}

load_chart_config() {
  try_load_chart_config || die "Template/$PARENT_NAME not found in namespace $OPERATOR_NS.
       Install the chart first (MIGRATION.md, step 1), or point --operator-namespace
       at the namespace holding it."
}

chart_value() {
  jq -r --arg k "$1" '.[$k] // ""' <<<"$PARENT_PARAMS"
}

# -- inventory ---------------------------------------------------------------

cmd_inventory() {
  load_chart_config

  local argo_ns scaffolding_mode annotation_key
  argo_ns=$(chart_value argoNamespace)
  scaffolding_mode=$(chart_value scaffoldingMode)
  annotation_key=$(chart_value scaffoldingAnnotationKey)

  heading "Chart"
  printf '  release namespace   %s\n' "$OPERATOR_NS"
  printf '  argocd.namespace    %s\n' "$argo_ns"
  printf '  scaffolding.mode    %s\n' "$scaffolding_mode"
  printf '  opt-in annotation   %s\n' "$annotation_key"

  if [[ $scaffolding_mode != OnAnnotation && $scaffolding_mode != OnLabel ]]; then
    warn "scaffolding.mode is $scaffolding_mode. Migration is per tenant, and
         Always opts every tenant in at once -- colliding with every Extensions CR
         still on this cluster."
  fi

  local ic ic_argo_ns wl_count bl_count
  ic=$(integrationconfig_json)
  ic_argo_ns=$(jq -r '.spec.integrations.argocd.namespace // ""' <<<"$ic")
  wl_count=$(jq '.spec.integrations.argocd.clusterResourceWhitelist // [] | length' <<<"$ic")
  bl_count=$(jq '.spec.integrations.argocd.namespaceResourceBlacklist // [] | length' <<<"$ic")

  heading "IntegrationConfig — the values that must move into chart values"
  printf '  integrations.argocd.namespace                   %s\n' "${ic_argo_ns:-<unset>}"
  printf '  integrations.argocd.clusterResourceWhitelist    %s entries\n' "$wl_count"
  printf '  integrations.argocd.namespaceResourceBlacklist  %s entries\n' "$bl_count"

  # A mismatch here is not a warning. The chart would render a second, separate
  # set of AppProjects beside the controller's rather than adopting them, and
  # every tenant would end up with two.
  if [[ -n $ic_argo_ns && $ic_argo_ns != "$argo_ns" ]]; then
    die "argocd.namespace mismatch: the chart renders into '$argo_ns', the
       IntegrationConfig names '$ic_argo_ns'. Adoption depends on the chart writing to
       the same namespace the controller wrote to.
       Reinstall with --set argocd.namespace=$ic_argo_ns."
  fi

  # These two are the silent ones. They are no longer read from the
  # IntegrationConfig, so a tenant whose AppProject carries them today loses both
  # lists the moment the chart adopts it -- unless they are seeded first.
  local chart_wl chart_bl
  chart_wl=$(chart_value defaultWhitelistJson)
  chart_bl=$(chart_value defaultBlacklistJson)
  if [[ $(jq 'length' <<<"${chart_wl:-[]}") != "$wl_count" ]] \
     || [[ $(jq 'length' <<<"${chart_bl:-[]}") != "$bl_count" ]]; then
    warn "the chart's resource lists do not match the IntegrationConfig's.
         Cutting a tenant over now would rewrite its AppProject WITHOUT them.
         Run '$0 values' and helm upgrade before going any further."
  fi

  local exts tenants appprojects
  exts=$(extensions_json)
  tenants=$(kc get "$TENANTS_GVR" -o json)
  appprojects=$(appprojects_json "$argo_ns")

  heading "Tenants"
  printf '  %-22s %-22s %-10s %-9s %s\n' TENANT EXTENSIONS APPPROJECT OPTED-IN NOTES
  local tenant ext_name has_ap opted notes
  while IFS=$'\t' read -r tenant ext_name has_ap opted notes; do
    [[ -z $tenant ]] && continue
    printf '  %-22s %-22s %-10s %-9s %s\n' "$tenant" "$ext_name" "$has_ap" "$opted" "$notes"
  done < <(jq -r --argjson exts "$exts" --argjson aps "$appprojects" --arg ann "$annotation_key" '
    .items[] as $t
    | (((($exts.items // [])[] | select(.spec.tenantName == $t.metadata.name)) // null)) as $e
    | (((($aps.items  // [])[] | select(.metadata.name  == $t.metadata.name)) // null)) as $ap
    | (($t.metadata.annotations // {})[$ann] == "true") as $in
    | ($e.spec.argoCD.appProject // {}) as $cfg
    | [
        (if ($e.spec.argoCD.onDeletePurgeAppProject // false)
           then "purge=true, patched to retain at cutover" else empty end),
        (if $cfg.sourceRepos != null then "sourceRepos override" else empty end),
        (if $cfg.clusterResourceWhitelist != null then "whitelist override" else empty end),
        (if $cfg.namespaceResourceBlacklist != null then "blacklist override" else empty end),
        (if $ap == null and $e != null
           then "NO AppProject: the controller never synced it" else empty end),
        # An AppProject with no CR is two different situations, and calling both
        # "orphan" makes a finished migration look like a problem.
        (if $ap != null and $e == null and $in
           then "done: chart-managed" else empty end),
        (if $ap != null and $e == null and ($in | not)
           then "orphan AppProject: no Extensions CR, adopted as-is at cutover" else empty end),
        (if $ap != null and (($ap.spec.sourceRepos // []) | length) == 0
           then "no sourceRepos: deploys nothing, before or after" else empty end)
      ] as $notes
    | [ $t.metadata.name,
        (if $e == null then "-" else $e.metadata.name end),
        (if $ap == null then "-" else "yes" end),
        (if $in then "yes" else "-" end),
        ($notes | join("; "))
      ] | @tsv' <<<"$tenants")

  # An Extensions CR naming a tenant that does not exist never produced an
  # AppProject and never will. It still holds the finalizer, so it still has to
  # be deleted before the CRD can be removed.
  local orphan_crs
  orphan_crs=$(jq -r --argjson t "$tenants" '
    [($t.items // [])[].metadata.name] as $names
    | (.items // [])[]
    | . as $cr
    | ($cr.spec.tenantName) as $tn
    | select($names | index($tn) == null)
    | "  \($cr.metadata.name)  ->  tenantName=\($tn), no such Tenant"' <<<"$exts")
  if [[ -n $orphan_crs ]]; then
    heading "Extensions CRs naming a tenant that does not exist"
    printf '%s\n' "$orphan_crs"
    printf '\n  Delete these too. They hold the finalizer that blocks removing the CRD.\n'
  fi

  report_legacy_owner_refs "$appprojects" || true
  report_gitops "$tenants" "$exts" "$appprojects"
  report_dead_v1beta2_argocd "$tenants"

  heading "Next"
  cat <<EOF
  1. $0 values > my-values.yaml   # then helm upgrade with it
  2. $0 annotations --apply
  3. $0 strip-owner-refs --apply
  4. $0 snapshot ./before-migration
  5. $0 cutover <one tenant> --apply   # verify, then the rest
  6. $0 diff ./before-migration

EOF
}

# -- values ------------------------------------------------------------------

cmd_values() {
  local ic
  ic=$(integrationconfig_json)

  # sourceRepos is deliberately absent from this output. It was never in the
  # IntegrationConfig -- it is per-tenant, and comes across as an annotation from
  # `annotations` below. See MIGRATION.md, step 8, on why setting a chart-wide
  # default is a separate change made after the diff is confirmed empty.
  jq -r '
    def kinds(list):
      if (list // []) | length == 0 then " []"
      else "\n" + ((list) | map("    - group: \"\(.group)\"\n      kind: \"\(.kind)\"") | join("\n"))
      end;
    (.spec.integrations.argocd.namespace // "") as $ns
    | "# Chart values seeded from IntegrationConfig \(.metadata.namespace)/\(.metadata.name).",
      "#",
      "# These three moved out of integrations.argocd, which the chart no longer reads.",
      "# Install or upgrade with them BEFORE cutting any tenant over: adopting a tenant",
      "# while the lists are unset rewrites its AppProject without them.",
      "argocd:",
      (if $ns == "" then
         "  namespace: \"\"  # MISSING from the IntegrationConfig -- set this by hand"
       else "  namespace: \($ns)" end),
      "  clusterResourceWhitelist:" + kinds(.spec.integrations.argocd.clusterResourceWhitelist),
      "  namespaceResourceBlacklist:" + kinds(.spec.integrations.argocd.namespaceResourceBlacklist)
  ' <<<"$ic"
}

# -- annotations -------------------------------------------------------------

cmd_annotations() {
  load_chart_config

  local exts
  exts=$(extensions_json)

  local tmp
  tmp=$(mktemp)
  # shellcheck disable=SC2064  # $tmp is intentionally expanded now, not at trap time
  trap "rm -f '$tmp'" EXIT

  # onDeletePurgeAppProject is carried across even though it has no effect today
  # (TOV2-1). A tenant that opted into purge should keep saying so, or the intent
  # is silently lost the day retain becomes enforceable.
  #
  # `!= null` rather than a truthiness test throughout: an Extensions CR that sets
  # a list to [] means "override with empty", which is a different thing from
  # leaving it unset, and skipping it would silently restore the chart default.
  jq -r \
    --arg kr "$(chart_value annotationSourceRepos)" \
    --arg kw "$(chart_value annotationClusterResourceWhitelist)" \
    --arg kb "$(chart_value annotationNamespaceResourceBlacklist)" \
    --arg kp "$(chart_value annotationOnDeletePurge)" '
    (.items // [])[]
    | .spec.tenantName as $t
    | (.spec.argoCD.appProject // {}) as $ap
    | [
        (if $ap.sourceRepos != null                then [$t, $kr, ($ap.sourceRepos | tojson)] else empty end),
        (if $ap.clusterResourceWhitelist != null   then [$t, $kw, ($ap.clusterResourceWhitelist | tojson)] else empty end),
        (if $ap.namespaceResourceBlacklist != null then [$t, $kb, ($ap.namespaceResourceBlacklist | tojson)] else empty end),
        (if (.spec.argoCD.onDeletePurgeAppProject // false) then [$t, $kp, "true"] else empty end)
      ][]
    | @tsv' <<<"$exts" >"$tmp"

  if [[ ! -s $tmp ]]; then
    printf 'No per-tenant overrides on any Extensions CR: every tenant inherits the\n'
    printf 'chart defaults, and there is nothing to carry across.\n'
    return
  fi

  printf 'Per-tenant overrides carried across from the Extensions CRs.\n'
  printf 'An absent annotation inherits the chart default; an explicit [] overrides with\n'
  printf 'empty. Both appear below, because they mean different things.\n\n'

  local tenant key value
  while IFS=$'\t' read -r tenant key value; do
    [[ -z $tenant ]] && continue
    run kc annotate "$TENANTS_GVR" "$tenant" "$key=$value" --overwrite
  done <"$tmp"

  (( APPLY )) || printf '\nRe-run with --apply to write these.\n'
}

# -- legacy ownerRefs --------------------------------------------------------

# Returns 0 when at least one AppProject is affected, so callers can branch.
report_legacy_owner_refs() {
  local affected
  affected=$(legacy_owner_ref_names "$1")
  [[ -n $affected ]] || return 1

  heading "AppProjects carrying a legacy $LEGACY_OWNER_APIVERSION Tenant ownerRef"
  printf '%s\n' "$affected" | sed 's/^/  /'
  cat <<EOF

  This is a CONTROLLER ownerRef, so the garbage collector deletes the AppProject
  when its Tenant goes away -- overriding any retain setting, now or later.
  ExtensionsArgoCDReconciler stripped it on every reconcile; nothing strips it
  once that controller is gone.

  Strip them with: $0 strip-owner-refs --apply
EOF
}

# -- preflight: things that change the whole procedure -----------------------

# tracked_names lists objects carrying ArgoCD's tracking metadata: the
# `app.kubernetes.io/instance` label (default trackingMethod) or the
# `argocd.argoproj.io/tracking-id` annotation (trackingMethod: annotation).
# ArgoCD stamps one or the other on everything it syncs.
tracked_names() {
  jq -r '
    (.items // [])[]
    | select(((.metadata.labels // {})["app.kubernetes.io/instance"] != null)
          or ((.metadata.annotations // {})["argocd.argoproj.io/tracking-id"] != null))
    | .metadata.name' <<<"$1"
}

# report_gitops decides whether the annotations this migration writes belong in
# Git rather than in kubectl. It ALWAYS prints, including when it finds nothing:
# tracking metadata is a positive signal only, so silence here would read as
# "not GitOps-managed" when it really means "could not tell".
report_gitops() {
  local tenants=$1 exts=$2 appprojects=$3
  local tracked_tenants tracked_exts tracked_aps
  tracked_tenants=$(tracked_names "$tenants")
  tracked_exts=$(tracked_names "$exts")
  tracked_aps=$(tracked_names "$appprojects")

  # An AppProject under GitOps is a different, worse problem: two writers for an
  # object this chart renders. Under sync.mode=strict the chart's webhook will
  # deny those syncs, and the migration is not the thing to fix first.
  if [[ -n $tracked_aps ]]; then
    heading "STOP: AppProjects appear to be GitOps-managed"
    printf '%s\n' "$tracked_aps" | sed 's/^/  /'
    cat <<EOF

  These carry ArgoCD tracking metadata, so something in Git is applying them.
  This chart renders AppProjects too, and under sync.mode=strict its webhook
  denies any other writer -- so those syncs will start failing.

  Remove the AppProject manifests from Git before migrating. They are generated
  objects; nobody should be authoring them.
EOF
    die "AppProjects are managed from Git. Resolve that first."
  fi

  heading "GitOps"
  if [[ -n $tracked_tenants || -n $tracked_exts ]]; then
    printf '  Tenants and/or Extensions carry ArgoCD tracking metadata:\n'
    if [[ -n $tracked_tenants ]]; then
      printf '%s\n' "$tracked_tenants" | sed 's|^|    tenant/|'
    fi
    if [[ -n $tracked_exts ]]; then
      printf '%s\n' "$tracked_exts" | sed 's|^|    extensions/|'
    fi
    cat <<EOF

  Every write this migration makes to a Tenant or an Extensions CR must be a
  COMMIT, not a kubectl command. The opt-in annotation decides whether a tenant
  has an AppProject at all; set it out of band and a sync can take it away
  again -- which deletes that AppProject.

  Do NOT use --apply on 'annotations' or 'cutover'. Use their dry-run output to
  write the manifests instead. See MIGRATION.md, "If your Tenants come from Git".
EOF
  else
    cat <<EOF
  No ArgoCD tracking metadata found on any Tenant or Extensions CR.

  That is NOT proof they are unmanaged -- tracking can be configured off, and
  other GitOps tools leave no marker at all. Confirm by hand before using
  --apply: if these objects come from Git, every write below has to be a commit.
EOF
  fi
}

# report_dead_v1beta2_argocd finds Tenants authored as v1beta2 with a spec.argocd
# block. Nothing reads it -- the v1beta2 -> v1beta3 conversion drops it silently
# -- so it cannot be read off the live object. last-applied-configuration is the
# only place the original intent survives, and only for objects applied with
# kubectl or a client-side-apply GitOps sync.
report_dead_v1beta2_argocd() {
  local dead
  dead=$(jq -r '
    (.items // [])[]
    | . as $t
    | (($t.metadata.annotations // {})["kubectl.kubernetes.io/last-applied-configuration"] // "") as $lac
    | select($lac != "")
    | ($lac | fromjson? // {}) as $orig
    | select(($orig.apiVersion // "") | test("v1beta2$"))
    | select($orig.spec.argocd != null)
    | "  \($t.metadata.name)"' <<<"$1")
  [[ -n $dead ]] || return 0

  heading "Tenants authored as v1beta2 with a spec.argocd block"
  printf '%s\n' "$dead"
  cat <<EOF

  Nothing reads that block, and nothing has for years: the v1beta2 -> v1beta3
  conversion drops it silently. It records intent that was never in effect.

  Do not carry it across as though it were current configuration. If one of
  these tenants has an AppProject anyway, find out what created it before
  adopting it.
EOF
}

legacy_owner_ref_names() {
  jq -r --arg av "$LEGACY_OWNER_APIVERSION" --arg k "$LEGACY_OWNER_KIND" '
    (.items // [])[]
    | select([(.metadata.ownerReferences // [])[]
        | select(.apiVersion == $av and .kind == $k)] | length > 0)
    | .metadata.name' <<<"$1"
}

cmd_strip_owner_refs() {
  load_chart_config
  local argo_ns appprojects
  argo_ns=$(chart_value argoNamespace)
  appprojects=$(appprojects_json "$argo_ns")

  if ! report_legacy_owner_refs "$appprojects"; then
    printf 'No AppProject in %s carries a legacy ownerRef. Nothing to do.\n' "$argo_ns"
    return
  fi

  heading "Stripping"
  # A JSON-merge patch that replaces the whole ownerReferences list, computed per
  # object from what is on it now. A JSON-pointer patch on a list index would
  # race anything else writing the object between the read and the write.
  local name patch
  while read -r name; do
    [[ -z $name ]] && continue
    patch=$(jq -c --arg av "$LEGACY_OWNER_APIVERSION" --arg k "$LEGACY_OWNER_KIND" --arg n "$name" '
      (.items // [])[] | select(.metadata.name == $n)
      | {metadata: {ownerReferences:
          [(.metadata.ownerReferences // [])[]
            | select((.apiVersion == $av and .kind == $k) | not)]}}' <<<"$appprojects")
    run kc patch "$APPPROJECTS_GVR" "$name" -n "$argo_ns" --type=merge -p "$patch"
  done < <(legacy_owner_ref_names "$appprojects")

  (( APPLY )) || printf '\nRe-run with --apply to write these.\n'
}

# -- snapshot and diff -------------------------------------------------------

# normalise strips everything that churns for reasons unrelated to content, so a
# diff after migration shows behaviour changes and nothing else.
#
# destinations are sorted because they come from an API-server LIST, so their
# order is not stable and carries no meaning. Roles and the groups inside them
# are NOT sorted: group order is load-bearing, and sorting it would hide a real
# change. jwtTokens are dropped because ArgoCD writes them into the spec and they
# move whenever someone mints a token.
normalise_appproject() {
  jq -S '{
    name: .metadata.name,
    spec: (.spec
      | .destinations = ((.destinations // []) | sort_by(.server, .namespace))
      | if has("roles") then .roles = [(.roles // [])[] | del(.jwtTokens)] else . end)
  }'
}

appproject_names() {
  kc get "$APPPROJECTS_GVR" -n "$1" -o jsonpath='{range .items[*]}{.metadata.name}{"\n"}{end}'
}

cmd_snapshot() {
  local dir=${1:-}
  [[ -n $dir ]] || die "snapshot needs a directory: $0 snapshot ./before-migration"
  load_chart_config
  local argo_ns
  argo_ns=$(chart_value argoNamespace)

  mkdir -p "$dir"
  local count=0 name
  while read -r name; do
    [[ -z $name ]] && continue
    kc get "$APPPROJECTS_GVR" "$name" -n "$argo_ns" -o json \
      | normalise_appproject >"$dir/$name.json"
    count=$((count + 1))
  done < <(appproject_names "$argo_ns")

  printf 'Wrote %d AppProject(s) from %s to %s/\n' "$count" "$argo_ns" "$dir"
  printf 'This is the only record of what the controller produced. Keep it until the\n'
  printf 'migration is signed off.\n'
}

cmd_diff() {
  local dir=${1:-}
  [[ -n $dir ]] || die "diff needs the snapshot directory: $0 diff ./before-migration"
  [[ -d $dir ]] || die "no such snapshot directory: $dir"
  load_chart_config
  local argo_ns
  argo_ns=$(chart_value argoNamespace)

  cat <<'EOF'
Comparing live AppProjects against the snapshot. Exactly two deltas are expected
for a tenant that has been cut over, and anything else needs an explanation
before you continue:

  - spec.description   "Managed by Extensions controller"
                    -> "Managed by mto-extension-argocd"

  - spec.roles[].groups gains that tenant's USERS, appended after its groups.
    This is the deliberate fix: MTO's generated group only resolves where
    syncOCPGroups has run, so a tenant whose owners are users had no ArgoCD
    access at all.

And one more, only for a tenant whose namespace list already contains the ArgoCD
namespace: a DUPLICATE destination disappears. The old controller appended the
ArgoCD namespace without checking whether the label selector had already found
it; the chart checks. ArgoCD treats the two as one either way.

A tenant not yet cut over must show no diff whatsoever.
EOF

  local tmp
  tmp=$(mktemp -d)
  # shellcheck disable=SC2064  # $tmp is intentionally expanded now, not at trap time
  trap "rm -rf '$tmp'" EXIT

  local changed=0 gone=0 added=0 name f
  for f in "$dir"/*.json; do
    [[ -e $f ]] || break
    name=$(basename "$f" .json)
    if ! kc get "$APPPROJECTS_GVR" "$name" -n "$argo_ns" -o json >"$tmp/raw.json" 2>/dev/null; then
      heading "$name -- GONE"
      printf '  In the snapshot, not on the cluster. A migration must never delete an\n'
      printf '  AppProject. Restore it from %s and stop.\n' "$f"
      gone=$((gone + 1))
      continue
    fi
    normalise_appproject <"$tmp/raw.json" >"$tmp/now.json"
    if ! diff -u "$f" "$tmp/now.json" >"$tmp/out.diff"; then
      heading "$name"
      sed '1,2d' "$tmp/out.diff" | sed 's/^/  /'
      changed=$((changed + 1))
    fi
  done

  while read -r name; do
    [[ -z $name ]] && continue
    if [[ ! -e "$dir/$name.json" ]]; then
      heading "$name -- NEW"
      printf '  On the cluster, not in the snapshot. Expected only for a tenant that had\n'
      printf '  no AppProject before it was cut over.\n'
      added=$((added + 1))
    fi
  done < <(appproject_names "$argo_ns")

  heading "Summary"
  printf '  %d changed, %d new, %d missing\n\n' "$changed" "$added" "$gone"
  (( gone == 0 )) \
    || die "an AppProject that existed before the migration is gone. Stop here and read
       MIGRATION.md, Rolling back."
}

# -- cutover -----------------------------------------------------------------

cmd_cutover() {
  (( $# > 0 )) || die "cutover needs at least one tenant name"
  load_chart_config

  local argo_ns scaffolding_mode key
  argo_ns=$(chart_value argoNamespace)
  scaffolding_mode=$(chart_value scaffoldingMode)
  case $scaffolding_mode in
    OnAnnotation) key=$(chart_value scaffoldingAnnotationKey) ;;
    OnLabel)      key=$(chart_value scaffoldingLabelKey) ;;
    *) die "scaffolding.mode is $scaffolding_mode, so there is no per-tenant opt-in to
       set. Migration has to be tenant by tenant: reinstall with OnAnnotation." ;;
  esac

  local exts tenant ext_name purge confirm
  exts=$(extensions_json)

  for tenant in "$@"; do
    heading "$tenant"

    kc get "$TENANTS_GVR" "$tenant" >/dev/null 2>&1 || die "no Tenant named $tenant"

    ext_name=$(jq -r --arg t "$tenant" '
      (.items // [])[] | select(.spec.tenantName == $t) | .metadata.name' <<<"$exts" | head -1)

    if [[ -n $ext_name ]]; then
      purge=$(jq -r --arg n "$ext_name" '
        (.items // [])[] | select(.metadata.name == $n)
        | .spec.argoCD.onDeletePurgeAppProject // false' <<<"$exts")

      # Retain first, and as its own write. Deleting a CR whose purge is true
      # destroys the live AppProject, which is the single outcome this whole
      # procedure exists to prevent -- so it is also re-read and confirmed below
      # rather than assumed from a successful patch.
      if [[ $purge == true ]]; then
        printf '  onDeletePurgeAppProject is true; patching it to retain before deleting\n'
        run kc patch "$EXTENSIONS_GVR" "$ext_name" --type=merge \
          -p '{"spec":{"argoCD":{"onDeletePurgeAppProject":false}}}'
        if (( APPLY )); then
          confirm=$(kc get "$EXTENSIONS_GVR" "$ext_name" \
            -o jsonpath='{.spec.argoCD.onDeletePurgeAppProject}')
          [[ $confirm == false ]] \
            || die "$ext_name still reports onDeletePurgeAppProject='$confirm'.
       Refusing to delete it: that would destroy AppProject/$tenant."
        fi
      fi

      # The finalizer on this CR is removed only by ExtensionsArgoCDReconciler,
      # so the delete has to happen while the old controller is still running. If
      # it hangs here, that controller is down -- bring it back up, do not clear
      # the finalizer by hand.
      printf '  deleting Extensions/%s (its finalizer needs the old controller running)\n' "$ext_name"
      # A hang here means one thing: ExtensionsArgoCDReconciler is not running,
      # so nothing is releasing tenantoperator.stakater.com/appproject. Say so,
      # because the obvious recovery -- clearing the finalizer by hand -- skips
      # the controller's retain check and can take the AppProject with it.
      if ! run kc delete "$EXTENSIONS_GVR" "$ext_name" --wait=true --timeout=120s; then
        die "deleting Extensions/$ext_name did not complete.
       Almost always this means ExtensionsArgoCDReconciler is not running: it is the
       only thing that removes the finalizer tenantoperator.stakater.com/appproject.
       Bring the controller back up and re-run. Do NOT clear the finalizer by hand --
       that skips its retain check.
       AppProject/$tenant has not been touched."
      fi

      if (( APPLY )); then
        kc get "$APPPROJECTS_GVR" "$tenant" -n "$argo_ns" >/dev/null 2>&1 \
          || die "AppProject/$tenant disappeared when its Extensions CR was deleted, so
       the retain patch did not take. Restore it from the snapshot before continuing,
       and cut over no further tenants."
        printf '  AppProject/%s survived the delete\n' "$tenant"
      fi
    else
      printf '  no Extensions CR for this tenant, nothing to drain\n'
    fi

    printf '  opting in with %s=true\n' "$key"
    if [[ $scaffolding_mode == OnAnnotation ]]; then
      run kc annotate "$TENANTS_GVR" "$tenant" "$key=true" --overwrite
    else
      run kc label "$TENANTS_GVR" "$tenant" "$key=true" --overwrite
    fi

    if (( APPLY )); then
      wait_for_child "$tenant"
    fi
  done

  (( APPLY )) || printf '\nRe-run with --apply to perform the cutover.\n'
}

# wait_for_child blocks until the tenant's child TemplateInstance reports Ready.
# "The annotation was written" is not the same as "the AppProject was adopted",
# and a failure is per tenant, so a multi-tenant run should stop on it rather
# than carry on.
wait_for_child() {
  local tenant=$1
  local child="${CHILD_PREFIX}${tenant}"
  local timeout=${MIGRATE_READY_TIMEOUT:-120}
  local deadline=$((SECONDS + timeout)) ready=''

  printf '  waiting for TemplateInstance/%s\n' "$child"
  while (( SECONDS < deadline )); do
    ready=$(kc get "$TEMPLATEINSTANCES_GVR" "$child" -n "$OPERATOR_NS" \
      -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || true)
    if [[ $ready == True ]]; then
      printf '  Ready. AppProject/%s is now managed by the chart.\n' "$tenant"
      return
    fi
    sleep 3
  done

  printf '\n'
  kc get "$TEMPLATEINSTANCES_GVR" "$child" -n "$OPERATOR_NS" \
    -o jsonpath='{range .status.conditions[?(@.status=="False")]}  {.type}: {.message}{"\n"}{end}' 2>&1 || true
  die "TemplateInstance/$child did not become Ready within ${timeout}s.
       The live AppProject has NOT been touched -- a child that fails to render applies
       nothing, so this is recoverable. Fix the cause above, or roll this tenant back
       per MIGRATION.md."
}

# -- run: the whole migration, one step at a time ----------------------------
#
# `run` exists so nobody has to hold the sequence in their head. It reads the
# cluster, works out which step is next, and either performs it (when it is
# cluster-only work) or prints the exact thing to commit (when it is not).
#
# The division is not arbitrary. Tenants and Extensions CRs are authored by you
# and live in Git; writing them from a script would put the switch that controls
# an AppProject's existence outside Git, where a sync can take it away again.
# AppProjects are generated, exist only in the cluster, and have no manifest to
# edit -- so that work is the tool's.
#
# Every state is derived from the cluster, never from a local file, so `run` is
# resumable: interrupt it, re-run it, hand the cluster to a colleague. The only
# thing on disk is the snapshot, and its absence is itself a state.

STATE_DIR='.mto-argocd-migrate'
BATCH=1

# Each step: is it done, and whose job is it.
S_INSTALLED=0 S_SEEDED=0 S_OVERRIDES=0 S_RETAIN=0
S_OWNERREFS=0 S_SNAPSHOT=0 S_CUTOVER_DONE=0 S_CUTOVER_TOTAL=0 S_DRAINED=0

compute_state() {
  local ic exts tenants appprojects argo_ns

  ic=$(integrationconfig_json)
  exts=$(extensions_json)
  tenants=$(kc get "$TENANTS_GVR" -o json)

  if try_load_chart_config; then
    S_INSTALLED=1
    argo_ns=$(chart_value argoNamespace)
  else
    argo_ns=$(jq -r '.spec.integrations.argocd.namespace // ""' <<<"$ic")
  fi
  appprojects=$(appprojects_json "$argo_ns")

  # 2. seeded: both resource lists match the IntegrationConfig's, and the chart
  #    writes into the namespace the controller already writes into.
  if (( S_INSTALLED )); then
    local wl bl cwl cbl
    wl=$(jq '.spec.integrations.argocd.clusterResourceWhitelist // [] | length' <<<"$ic")
    bl=$(jq '.spec.integrations.argocd.namespaceResourceBlacklist // [] | length' <<<"$ic")
    cwl=$(jq 'length' <<<"$(chart_value defaultWhitelistJson)")
    cbl=$(jq 'length' <<<"$(chart_value defaultBlacklistJson)")
    if [[ $wl == "$cwl" && $bl == "$cbl" && -n $argo_ns ]]; then
      S_SEEDED=1
    fi
  fi

  # 3. overrides: every Extensions CR override has a matching Tenant annotation.
  #    Compared by VALUE, not just presence -- a stale annotation is as wrong as
  #    a missing one, and both silently change what the AppProject gets.
  if (( S_INSTALLED )); then
    local missing
    missing=$(pending_override_annotations "$exts" "$tenants")
    [[ -z $missing ]] && S_OVERRIDES=1
  fi

  # 4. retain: no CR still says purge. This gates everything after it, because
  #    deleting a purge=true CR destroys the live AppProject.
  [[ $(jq '[(.items // [])[] | select(.spec.argoCD.onDeletePurgeAppProject // false)] | length' <<<"$exts") == 0 ]] \
    && S_RETAIN=1

  # 5-6. the tool's own work.
  [[ -z $(legacy_owner_ref_names "$appprojects") ]] && S_OWNERREFS=1
  [[ -d $STATE_DIR/snapshot ]] && S_SNAPSHOT=1

  # 7. cutover, counted per tenant.
  #
  # The denominator is tenants IN SCOPE, not every Tenant on the cluster: one
  # with neither an Extensions CR nor an AppProject was never served by the
  # controller and has nothing to migrate. Counting it would leave the step
  # permanently short of its total and make a finished migration look unfinished.
  local key mode
  mode=$( (( S_INSTALLED )) && chart_value scaffoldingMode || echo "" )
  key=$( (( S_INSTALLED )) && chart_value scaffoldingAnnotationKey || echo "" )
  S_CUTOVER_TOTAL=$(jq --argjson e "$exts" --argjson a "$appprojects" '
    [ (.items // [])[]
      | . as $t
      | select(([($e.items // [])[] | select(.spec.tenantName == $t.metadata.name)] | length > 0)
            or ([($a.items // [])[] | select(.metadata.name  == $t.metadata.name)] | length > 0))
    ] | length' <<<"$tenants")
  S_CUTOVER_DONE=$(jq --argjson e "$exts" --argjson a "$appprojects" --arg ann "$key" '
    [ (.items // [])[]
      | . as $t
      | select([($a.items // [])[] | select(.metadata.name == $t.metadata.name)] | length > 0)
      | select([($e.items // [])[] | select(.spec.tenantName == $t.metadata.name)] | length == 0)
      | select((($t.metadata.annotations // {})[$ann] // "") == "true")
    ] | length' <<<"$tenants")

  # 8. drained: zero Extensions objects, including any naming a tenant that
  #    does not exist -- those hold the finalizer that blocks removing the CRD.
  [[ $(jq '(.items // []) | length' <<<"$exts") == 0 ]] && S_DRAINED=1

  RUN_IC=$ic RUN_EXTS=$exts RUN_TENANTS=$tenants RUN_APS=$appprojects
  RUN_ARGO_NS=$argo_ns RUN_MODE=$mode RUN_OPTIN_KEY=$key
}

# pending_override_annotations lists tenant/key/value triples whose Extensions CR
# sets an override the Tenant does not carry, or carries with a different value.
pending_override_annotations() {
  jq -r --argjson t "$2" \
    --arg kr "$(chart_value annotationSourceRepos)" \
    --arg kw "$(chart_value annotationClusterResourceWhitelist)" \
    --arg kb "$(chart_value annotationNamespaceResourceBlacklist)" \
    --arg kp "$(chart_value annotationOnDeletePurge)" '
    [($t.items // [])[]] as $tenants
    | (.items // [])[]
    | .spec.tenantName as $tn
    | (.spec.argoCD.appProject // {}) as $ap
    | (.spec.argoCD.onDeletePurgeAppProject // false) as $purge
    | (($tenants[] | select(.metadata.name == $tn) | .metadata.annotations) // {}) as $have
    | [
        (if $ap.sourceRepos != null                then [$kr, ($ap.sourceRepos | tojson)] else empty end),
        (if $ap.clusterResourceWhitelist != null   then [$kw, ($ap.clusterResourceWhitelist | tojson)] else empty end),
        (if $ap.namespaceResourceBlacklist != null then [$kb, ($ap.namespaceResourceBlacklist | tojson)] else empty end),
        (if $purge then [$kp, "true"] else empty end)
      ][]
    | select($have[.[0]] != .[1])
    | [$tn, .[0], .[1]] | @tsv' <<<"$1"
}

checkbox() { (( $1 )) && printf '[x]' || printf '[ ]'; }

print_state() {
  heading "Migration state"
  printf '  %s 1  chart installed\n'                       "$(checkbox $S_INSTALLED)"
  printf '  %s 2  resource lists seeded from the IntegrationConfig\n' "$(checkbox $S_SEEDED)"
  printf '  %s 3  per-tenant overrides carried across\n'   "$(checkbox $S_OVERRIDES)"
  printf '  %s 4  onDeletePurgeAppProject false everywhere\n' "$(checkbox $S_RETAIN)"
  printf '  %s 5  legacy ownerRefs stripped\n'             "$(checkbox $S_OWNERREFS)"
  printf '  %s 6  snapshot taken\n'                        "$(checkbox $S_SNAPSHOT)"
  printf '  %s 7  tenants cut over            %s of %s\n'  \
    "$(checkbox $(( S_CUTOVER_DONE == S_CUTOVER_TOTAL && S_CUTOVER_TOTAL > 0 )))" \
    "$S_CUTOVER_DONE" "$S_CUTOVER_TOTAL"
  printf '  %s 8  Extensions CRs drained\n'                "$(checkbox $S_DRAINED)"
}

commit_block() {
  printf '\n  ----- commit this -------------------------------------------------\n'
  sed 's/^/  /'
  printf '  -------------------------------------------------------------------\n'
  printf '\n  Then sync, and run `%s run` again.\n\n' "$0"
}

cmd_run() {
  compute_state
  print_state

  if (( ! S_INSTALLED )); then
    heading "Next — install the chart"
    cat <<EOF
  Nothing is scaffolded by installing: scaffolding.mode defaults to OnAnnotation.
  These values come from the live IntegrationConfig, so install with them rather
  than installing bare and upgrading afterwards.
EOF
    cmd_values | commit_block
    return
  fi

  if (( ! S_SEEDED )); then
    heading "Next — seed the resource lists"
    cat <<EOF
  The chart no longer reads integrations.argocd from the IntegrationConfig. Cut a
  tenant over before this lands and its AppProject loses both lists, silently.
EOF
    cmd_values | commit_block
    return
  fi

  if (( ! S_OVERRIDES )); then
    heading "Next — carry the per-tenant overrides across"
    cat <<EOF
  These are inert until a tenant is opted in, so they are safe to land now. An
  absent annotation inherits the chart default; an explicit [] overrides with
  empty, which is why a CR setting [] is carried across as [] and not skipped.
EOF
    emit_override_annotations | commit_block
    return
  fi

  if (( ! S_RETAIN )); then
    heading "Next — turn purge off, and let it land on its own"
    cat <<EOF
  "Purge" means delete. Any CR below would destroy its live AppProject the moment
  it is removed -- and if the chart already held that AppProject, the controller's
  delete would be denied instead, leaving the CR in Terminating forever.

  This MUST be its own commit. Do not combine it with deleting the CR.
EOF
    emit_retain_edits | commit_block
    return
  fi

  if (( ! S_OWNERREFS )); then
    heading "Next — strip legacy ownerRefs (mine to do)"
    printf '  AppProjects are generated objects with no manifest in Git, so this is a\n'
    printf '  direct patch. It removes only the v1beta2 Tenant ref.\n\n'
    cmd_strip_owner_refs
    if (( APPLY )); then
      printf '\n  Done. Run `%s run` again.\n' "$0"
    fi
    return
  fi

  if (( ! S_SNAPSHOT )); then
    heading "Next — snapshot every AppProject (mine to do)"
    printf '  The only record of what the controller produced, and what every later\n'
    printf '  diff compares against.\n\n'
    if (( APPLY )); then
      cmd_snapshot "$STATE_DIR/snapshot"
      printf '\n  Run `%s run` again.\n' "$0"
    else
      printf '  would run: %s snapshot %s/snapshot\n\n' "$0" "$STATE_DIR"
    fi
    return
  fi

  # From here on, every AppProject the chart already owns is compared against the
  # snapshot on every run. That is the go/no-go gate, and it is shown before the
  # next tenant is offered rather than after.
  if (( S_CUTOVER_DONE > 0 )); then
    cmd_diff "$STATE_DIR/snapshot"
  fi

  local next count
  next=$(next_tenants_to_cut_over)
  if [[ -n $next ]]; then
    count=$(wc -w <<<"$next" | tr -d ' ')
    heading "Next — cut over $count $( (( count == 1 )) && echo tenant || echo tenants )"
    cat <<EOF
  One commit per tenant: delete its Extensions CR and add the opt-in annotation.
  They can be the same commit now that purge is off everywhere -- worst case is a
  few seconds where both writers claim the AppProject, and the chart wins.
EOF
    # Only point at a diff that was actually printed. Telling someone to read a
    # diff that is not on screen teaches them to skip the instruction.
    if (( S_CUTOVER_DONE > 0 )); then
      cat <<EOF

  Read the diff above first. If anything beyond the description and the added
  users has changed, stop.
EOF
    fi
    emit_cutover "$next" | commit_block
    return
  fi

  if (( ! S_DRAINED )); then
    heading "Next — delete the leftover Extensions CRs"
    printf '  These name tenants that do not exist, so they never produced an AppProject.\n'
    printf '  They still hold the finalizer that blocks removing the CRD.\n\n'
    jq -r '(.items // [])[] | "  - Extensions/\(.metadata.name)  (tenantName=\(.spec.tenantName))"' <<<"$RUN_EXTS"
    printf '\n  Delete their manifests from Git, sync, then run `%s run` again.\n\n' "$0"
    return
  fi

  heading "Done"
  cat <<EOF
  Every tenant is on the chart and no Extensions CRs remain.

  Remaining, in this order -- reversing the last two wedges the CRD:
    1. remove ExtensionsArgoCDReconciler and its Deployment
    2. then remove the Extensions CRD

  Set sourceRepos for any tenant that has none (MIGRATION.md, step 10). Keep
  $STATE_DIR/snapshot until this is signed off.

EOF
}

# next_tenants_to_cut_over returns the next BATCH tenants still to migrate: those
# with an Extensions CR to drain, or with an AppProject the chart has not adopted.
# The second case is the orphan -- an AppProject nobody ever wrote a CR for.
next_tenants_to_cut_over() {
  jq -r --argjson e "$RUN_EXTS" --argjson a "$RUN_APS" --arg ann "$RUN_OPTIN_KEY" --argjson n "$BATCH" '
    [ (.items // [])[]
      | . as $t
      | select(([($e.items // [])[] | select(.spec.tenantName == $t.metadata.name)] | length > 0)
            or ([($a.items // [])[] | select(.metadata.name  == $t.metadata.name)] | length > 0))
      | select((($t.metadata.annotations // {})[$ann] // "") != "true")
      | $t.metadata.name ] | .[0:$n] | join(" ")' <<<"$RUN_TENANTS"
}

emit_override_annotations() {
  local tenant key value current=''
  while IFS=$'\t' read -r tenant key value; do
    [[ -z $tenant ]] && continue
    if [[ $tenant != "$current" ]]; then
      [[ -n $current ]] && printf '\n'
      printf '# the Tenant manifest for %s\nmetadata:\n  annotations:\n' "$tenant"
      current=$tenant
    fi
    printf '    %s: %s\n' "$key" "'$value'"
  done < <(pending_override_annotations "$RUN_EXTS" "$RUN_TENANTS")
}

emit_retain_edits() {
  jq -r '(.items // [])[]
    | select(.spec.argoCD.onDeletePurgeAppProject // false)
    | "# the Extensions manifest for \(.metadata.name)\nspec:\n  argoCD:\n    onDeletePurgeAppProject: false\n"' <<<"$RUN_EXTS"
}

emit_cutover() {
  local tenant ext
  for tenant in $1; do
    ext=$(jq -r --arg t "$tenant" '(.items // [])[] | select(.spec.tenantName == $t) | .metadata.name' <<<"$RUN_EXTS" | head -1)
    printf '# 1. DELETE the manifest defining Extensions/%s\n' "$ext"
    printf '# 2. the Tenant manifest for %s\n' "$tenant"
    if [[ $RUN_MODE == OnLabel ]]; then
      printf 'metadata:\n  labels:\n    %s: "true"\n\n' "$RUN_OPTIN_KEY"
    else
      printf 'metadata:\n  annotations:\n    %s: "true"\n\n' "$RUN_OPTIN_KEY"
    fi
  done
}

# -- entrypoint --------------------------------------------------------------

main() {
  local positional=()
  while (( $# )); do
    case $1 in
      --context)            CONTEXT=${2:?--context needs a value}; shift 2 ;;
      --operator-namespace) OPERATOR_NS=${2:?--operator-namespace needs a value}; shift 2 ;;
      --integrationconfig)  IC_NAME=${2:?--integrationconfig needs a value}; shift 2 ;;
      --ic-namespace)       IC_NS=${2:?--ic-namespace needs a value}; shift 2 ;;
      --apply)              APPLY=1; shift ;;
      --state-dir)          STATE_DIR=${2:?--state-dir needs a value}; shift 2 ;;
      --batch)              BATCH=${2:?--batch needs a value}; shift 2 ;;
      -h|--help)            usage; exit 0 ;;
      --*)                  die "unknown flag: $1" ;;
      *)                    positional[${#positional[@]}]=$1; shift ;;
    esac
  done

  (( ${#positional[@]} )) || { usage; exit 1; }
  require_tools
  IC_NS=${IC_NS:-$OPERATOR_NS}

  local cmd=${positional[0]}
  local args=()
  if (( ${#positional[@]} > 1 )); then
    args=("${positional[@]:1}")
  fi

  case $cmd in
    run)              cmd_run ;;
    inventory)        cmd_inventory ;;
    values)           cmd_values ;;
    annotations)      cmd_annotations ;;
    strip-owner-refs) cmd_strip_owner_refs ;;
    snapshot)         cmd_snapshot ${args[@]+"${args[@]}"} ;;
    diff)             cmd_diff ${args[@]+"${args[@]}"} ;;
    cutover)          cmd_cutover ${args[@]+"${args[@]}"} ;;
    *)                die "unknown command: $cmd (try --help)" ;;
  esac
}

main "$@"
